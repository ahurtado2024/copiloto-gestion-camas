# =================================================================
# COPILOTO GESTIÓN DE CAMAS — variables de entorno
# Copia este archivo a .env.local y completa los valores
# NUNCA subir .env ni .env.local al repositorio
# =================================================================

# ---- Base de datos principal (Supabase) -------------------------
# RUNTIME APP (Next.js / Vercel / serverless): usar pooler transaction mode (6543)
# Recomendado por Supabase para serverless/edge functions
# Formato oficial típico:
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/copiloto_camas_dev

# MIGRACIONES / DRIZZLE PUSH: usar conexión directa (5432)
# Supabase recomienda DIRECT connection para migraciones, pg_dump, backup/restore
# Formato oficial típico:
# postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@localhost:5432/copiloto_camas_dev

# ---- Google Sheets (integración futura v1.2) --------------------
# Hoja de cálculo del turno — el sistema lee en paralelo, NO escribe
# Obtener desde: Google Cloud Console → Credentials → Service Account → JSON key
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=copiloto@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ---- Gmail API (integración futura v1.1) ------------------------
# Canal oficial de correo institucional
# Obtener desde: Google Cloud Console → Credentials → OAuth 2.0
GMAIL_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-abc123
GMAIL_REFRESH_TOKEN=1//0abc...

# ---- Telegram Bot (integración futura v1.1) ---------------------
# Canal de turno — avisos a aseo y aprobaciones rápidas
# Obtener desde: @BotFather en Telegram → /newbot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID_TURNO=-1001234567890
TELEGRAM_CHAT_ID_ASEO=-1009876543210

# ---- Integración Universal de Correo (IMAP) ---------------------
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=tu-correo@ejemplo.com
MAIL_IMAP_PASS=tu-password-app
MAIL_IMAP_SECURE=true
# MAIL_LOOKBACK_DAYS=90 (opcional, por defecto 90 días = aprox. 3 meses)

# ---- Auth (v1.0-stable) -----------------------------------------
# Usar Clerk o NextAuth
# NEXTAUTH_URL=https://tu-dominio.vercel.app
# NEXTAUTH_SECRET=genera-con: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ---- Observabilidad (opcional, recomendado en staging) ----------
# Sentry para errores del servidor
SENTRY_DSN=https://abc123@o000000.ingest.sentry.io/0000000

# ---- Feature flags de entorno -----------------------------------
# Controla qué funciones están activas según el entorno
# "demo" | "dev" | "staging" | "pilot"
APP_ENV=demo

# ---- Supabase (referencia directa, alternativa a DATABASE_URL) --
# Útil para funciones que usan el SDK de Supabase directamente
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

